          "content": {
            "size": 891,
            "mimeType": "text/html",
            "compression": 6,
            "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Demo Health Shop (fictional)</title>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n</head>\n<body>\n  <!-- Fictional fixture. Every third-party call below is a deliberate privacy problem for the scanner to find. -->\n  <h1>Demo Health Shop</h1>\n  <form id=\"signup\">\n    <label>Full name <input name=\"full_name\" required></label>\n    <label>Email <input name=\"email\" type=\"email\" required></label>\n    <label>Phone <input name=\"phone\" required></label>\n    <label>IBAN <input name=\"iban\" required></label>\n    <label>Health insurance number <input name=\"kvnr\" required></label>\n    <label>Diagnosis (ICD-10) <input name=\"diagnosis\" required></label>\n    <button type=\"submit\">Create account</button>\n  </form>\n  <p id=\"status\" role=\"status\"></p>\n  <script src=\"/app.js\"></script>\n</body>\n</html>\n"
          },
          "headersSize": 65,
          "bodySize": 885,
          "redirectURL": "",
          "_transferSize": 950
        },
