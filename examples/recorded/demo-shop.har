      },
      {
        "pageref": "page@80e99508759c890a2055f35df779eed5",
        "startedDateTime": "2026-10-17T23:38:19.070Z",
        "time": 17.934,
        "request": {
          "method": "GET",
          "url": "https://shop.example/app.js",
          "httpVersion": "HTTP/1.1",
          "cookies": [],
          "headers": [
