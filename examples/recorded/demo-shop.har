{"log":{"version":"1.2","creator":{"name":"Playwright","version":"1.64.0-beta-1791568591000"},"browser":{"name":"chromium","version":"156.0.8078.4"},"pages":[{"startedDateTime":"2026-10-14T17:40:23.275Z","id":"page@2ad974907785969b5855a8c42307a242","title":"Demo Health Shop (fictional)","pageTimings":{"onContentLoad":206,"onLoad":206}}],"entries":[{"pageref":"page@2ad974907785969b5855a8c42307a242","startedDateTime":"2026-10-14T17:40:23.288Z","time":75.016,"request":{"method":"GET","url":"https://shop.example/","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/html,application/xhtml+xml,application/xml;q=0.9,image/jxl,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"},{"name":"Upgrade-Insecure-Requests","value":"1"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/156.0.8078.4 Safari/537.36"},{"name":"sec-ch-ua","value":"\"Not:A-Brand\";v=\"8\", \"Chromium\";v=\"156\", \"HeadlessChrome\";v=\"156\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":468,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"content-length","value":"891"},{"name":"content-type","value":"text/html"}],"content":{"size":891,"mimeType":"text/html","compression":6,"text":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Demo Health Shop (fictional)</title>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n</head>\n<body>\n  <!-- Fictional fixture. Every third-party call below is a deliberate privacy problem for the scanner to find. -->\n  <h1>Demo Health Shop</h1>\n  <form id=\"signup\">\n    <label>Full name <input name=\"full_name\" required></label>\n    <label>Email <input name=\"email\" type=\"email\" required></label>\n    <label>Phone <input name=\"phone\" required></label>\n    <label>IBAN <input name=\"iban\" required></label>\n    <label>Health insurance number <input name=\"kvnr\" required></label>\n    <label>Diagnosis (ICD-10) <input name=\"diagnosis\" required></label>\n    <button type=\"submit\">Create account</button>\n  </form>\n  <p id=\"status\" role=\"status\"></p>\n  <script src=\"/app.js\"></script>\n</body>\n</html>\n"},"headersSize":65,"bodySize":885,"redirectURL":"","_transferSize":950},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":73.93,"receive":1.086},"_frameref":"frame@b8ec36ee24a6c10807b11aea226f8cb8","_monotonicTime":9872.133,"_resourceType":"document","_wasFulfilled":true,"_securityDetails":{}},{"pageref":"page@2ad974907785969b5855a8c42307a242","startedDateTime":"2026-10-14T17:40:23.370Z","time":55.814,"request":{"method":"GET","url":"https://shop.example/app.js","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Referer","value":"https://shop.example/"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/156.0.8078.4 Safari/537.36"},{"name":"sec-ch-ua","value":"\"Not:A-Brand\";v=\"8\", \"Chromium\";v=\"156\", \"HeadlessChrome\";v=\"156\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":334,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"content-type","value":"text/javascript"},{"name":"content-length","value":"3194"}],"content":{"size":3194,"mimeType":"text/javascript","compression":6,"text":"// Fictional demo app. Hosts ending in .test or .example do not exist; the recorder answers them locally.\nasync function sha256Hex(text) {\n  const digest = await crypto.subtle.digest(\"SHA-256\", new TextEncoder().encode(text));\n  return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, \"0\")).join(\"\");\n}\n\nfunction base64url(text) {\n  return btoa(text).replace(/\\+/g, \"-\").replace(/\\//g, \"_\").replace(/=+$/, \"\");\n}\n\nfunction fakeJwt(claims) {\n  return `${base64url(JSON.stringify({ alg: \"HS256\", typ: \"JWT\" }))}.${base64url(JSON.stringify(claims))}.demo-signature`;\n}\n\nasync function send(url, options = {}) {\n  try {\n    await fetch(url, { mode: \"cors\", ...options });\n  } catch (error) {\n    console.warn(\"demo request failed\", url, error);\n  }\n}\n\ndocument.getElementById(\"signup\").addEventListener(\"submit\", async (event) => {\n  event.preventDefault();\n  const form = Object.fromEntries(new FormData(event.target));\n  const json = { \"Content-Type\": \"application/json\" };\n  const phoneDigits = form.phone.replace(/\\D/g, \"\");\n\n  // First party: expected processing over HTTPS (reported as info/low for review, not as a leak).\n  await send(\"https://shop.example/api/signup\", {\n    method: \"POST\",\n    headers: json,\n    body: JSON.stringify({ full_name: form.full_name, email: form.email, phone: form.phone }),\n  });\n  await send(\"https://shop.example/api/intake\", {\n    method: \"POST\",\n    headers: { ...json, Authorization: `Bearer ${fakeJwt({ sub: \"user-42\", email: form.email })}` },\n    body: JSON.stringify({ kvnr: form.kvnr, diagnosis: form.diagnosis }),\n  });\n\n  // Third party analytics: plain email and name in a JSON body.\n  await send(\"https://api.analytics-vendor.test/v1/track\", {\n    method: \"POST\",\n    headers: json,\n    body: JSON.stringify({ event: \"signup\", traits: { email: form.email, full_name: form.full_name } }),\n  });\n\n  // Ad pixel: hashed email and phone in the query string (still personal data).\n  const em = await sha256Hex(form.email.trim().toLowerCase());\n  const ph = await sha256Hex(phoneDigits);\n  await send(`https://collect.pixel-tracker.test/p?ev=Lead&em=${em}&ph=${ph}`);\n\n  // Legacy ad server over plain HTTP, with the email inside a nested page URL.\n  const page = `https://shop.example/welcome?email=${encodeURIComponent(form.email)}`;\n  await send(`http://ads.legacy-ads.test/i.gif?ref=${encodeURIComponent(page)}`);\n\n  // Session replay vendor: Base64-wrapped form snapshot including health data.\n  const snapshot = btoa(JSON.stringify({ form: { kvnr: form.kvnr, diagnosis: form.diagnosis } }));\n  await send(\"https://rec.session-cam.test/v2/events\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"text/plain\" },\n    body: snapshot,\n  });\n\n  // Map widget: precise coordinates in the URL.\n  await send(\"https://maps.geo-widgets.test/tiles?lat=52.520008&lng=13.404954&z=17\");\n\n  // Payment processor: IBAN and email, approved in the config as a contracted processor.\n  await send(\"https://api.payments-processor.test/v1/mandates\", {\n    method: \"POST\",\n    headers: json,\n    body: JSON.stringify({ iban: form.iban, email: form.email }),\n  });\n\n  document.getElementById(\"status\").textContent = \"Account created (demo).\";\n});\n"},"headersSize":72,"bodySize":3188,"redirectURL":"","_transferSize":3260},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":54.128,"receive":1.686},"_frameref":"frame@b8ec36ee24a6c10807b11aea226f8cb8","_monotonicTime":9952.464,"_resourceType":"script","_wasFulfilled":true,"_securityDetails":{}},{"pageref":"page@2ad974907785969b5855a8c42307a242","startedDateTime":"2026-10-14T17:40:23.654Z","time":6.0969999999999995,"request":{"method":"POST","url":"https://shop.example/api/signup","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Content-Type","value":"application/json"},{"name":"Origin","value":"https://shop.example"},{"name":"Referer","value":"https://shop.example/"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/156.0.8078.4 Safari/537.36"},{"name":"sec-ch-ua","value":"\"Not:A-Brand\";v=\"8\", \"Chromium\";v=\"156\", \"HeadlessChrome\";v